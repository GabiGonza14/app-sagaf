{
  "name": "sagaf-app",
  "version": "1.0.0",
  "private": true,
  "description": "SAGAF — Sistema Automatizado de Gestión de Análisis Financiero (UAF Panamá). Parcial 2 ISA IV — UTP 1GS241.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx db/init.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/reset.ts",
    "db:backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@auth/core": "0.34.2",
    "@napi-rs/canvas": "^1.0.1",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.3.0",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "14.2.15",
    "next-auth": "5.0.0-beta.20",
    "otplib": "12.0.1",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "18.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.16.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "pdf-lib": "^1.17.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/canvas",
      "better-sqlite3",
      "esbuild",
      "tesseract.js",
      "unrs-resolver"
    ]
  }
}
