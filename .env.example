# Copiar a .env.local antes de `pnpm dev`:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)

# Obligatorio — NextAuth / JWT / MFA (generar en prod: openssl rand -hex 32)
AUTH_SECRET=

# Desarrollo local con localhost
AUTH_TRUST_HOST=true

# Opcional — ruta de uploads (default: ./var/uploads)
# UPLOADS_DIR=./var/uploads
